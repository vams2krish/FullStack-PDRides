# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pdrides

# Web App URL (for links in messages)
WEB_APP_URL=http://localhost:3002

# WhatsApp Configuration
# Phone Number ID from Meta Developer Portal
WHATSAPP_PHONE_NUMBER_ID=938254902715158
# Access Token from Meta Developer Portal (WhatsApp API -> Configuration)
WHATSAPP_ACCESS_TOKEN=your_access_token_here
# Webhook verify token (you choose this, must match in Meta portal)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token

# Telegram Configuration (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Map Configuration
MAPBOX_TOKEN=your_mapbox_token
OPENROUTESERVICE_KEY=your_openrouteservice_key

# Max ride results
MAX_RIDE_RESULTS=5

