# PDRides Environment Configuration
# Copy this file to .env and fill in your values

# App Configuration
APP_NAME=PDRides
PORT=3000
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/pdrides
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/pdrides
MONGODB_URI=mongodb://localhost:27017/pdrides

# WhatsApp Cloud API (from Meta Developer Dashboard)
# Get these from https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token

# Webhook Verification Token (create your own secure token)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# Web App URL (for map links in WhatsApp messages)
# Example: https://your-domain.com or https://xxx.ngrok.io
WEB_APP_URL=http://localhost:3000

# Optional Configuration
# MAX_RIDE_RESULTS=5

