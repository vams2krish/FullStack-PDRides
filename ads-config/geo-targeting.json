  "targetingTypes": {
    "all": {
      "description": "Target all locations",
      "requires": [],
      "priority": 0
    },
    "states": {
      "description": "Target specific US states",
      "requires": ["states"],
      "priority": 1,
      "example": {
        "geoType": "states",
        "states": ["NJ", "NY", "PA"]
      }
    },
    "zipcodes": {
      "description": "Target specific zip codes",
      "requires": ["zipcodes"],
      "priority": 2,
      "matchtypes": [
        { "type": "exact", "description": "Match exact 5-digit zip code", "example": "08830" },
        { "type": "prefix", "description": "Match zip codes by prefix (first 3 digits)", "example": "088" }
      ],
      "example": {
        "geoType": "zipcodes",
        "zipcodes": [
          { "code": "08830", "matchtype": "exact" },
          { "code": "088", "matchtype": "prefix" }
        ]
      }
    },
    "radius": {
      "description": "Target within radius of a point",
      "requires": ["radius"],
      "priority": 3,
      "maxRadiusMiles": 50,
      "example": {
        "geoType": "radius",
        "radius": {
          "center": { "lat": 40.7128, "lng": -74.006 },
          "radiusMiles": 25
        }
      }
    }
  },
  "dayparting": {
    "enabled": true,
    "timezone": "America/New_York",
    "days": [
      "monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"
    ],
    "timeFormat": "HH:MM",
    "example": {
      "schedule": {
        "daysOfWeek": ["monday", "tuesday", "wednesday", "thursday", "friday"],
        "startTime": "09:00",
        "endTime": "17:00"
      }
    }
  },
  "validation": {
    "maxStatesPerAd": 50,
    "maxZipcodesPerAd": 500,
    "minRadiusMiles": 1,
    "maxRadiusMiles": 50,
    "zipcodeFormat": "^\\d{5}$"
  }
}

